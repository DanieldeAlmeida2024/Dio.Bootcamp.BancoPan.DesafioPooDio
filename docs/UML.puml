@startuml
abstract class Conteudo { XP_PADRAO=10; titulo; descricao; calcularXp() }
class Curso { cargaHoraria; calcularXp() }
class Mentoria { data; calcularXp() }
class Bootcamp { nome; descricao; conteudos; devsInscritos }
class Dev { Nome; conteudosInscritos; conteudosConcluidos; inscreverBootcamp(); progredir(); calcularTotalXp() }
Conteudo <|-- Curso
Conteudo <|-- Mentoria
Bootcamp "1" o-- "*" Conteudo
Bootcamp "*" -- "*" Dev : inscritos
Dev "1" o-- "*" Conteudo : inscritos/concluidos
@enduml
